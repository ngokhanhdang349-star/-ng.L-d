local function GetBodyColor(character)
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Head")
    if torso and torso:IsA("BasePart") then
        return torso.Color
    end
    return Color3.fromRGB(255, 255, 255)
end

function ApplyHitboxToCharacter(character)
    if not character then return end
    
    local hrp = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:WaitForChild("Humanoid", 10)
    
    if hrp and humanoid then
        if PlayerHitboxEnabled then
            hrp.Size = HitboxSize
            hrp.Transparency = HitboxTransparencyVal
            hrp.Color = GetBodyColor(character)
            hrp.Material = Enum.Material.Neon
            hrp.CanCollide = false
            hrp.CanTouch = true
            hrp.CanQuery = true
        else
            hrp.Size = DefaultSize
            hrp.Transparency = 1
            hrp.CanCollide = false
            hrp.CanTouch = true
            hrp.CanQuery = true
        end
    end
end

function ApplyPlayerHitbox()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            task.spawn(function()
                ApplyHitboxToCharacter(player.Character)
            end)
        end
    end
end

