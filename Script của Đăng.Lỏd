local function UpdatePlayerListUI()
    for _, child in pairs(PlayerListFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local count = 0
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            count = count + 1
            
            if SelectedPlayers[player.Name] == nil then
                SelectedPlayers[player.Name] = true
            end

            local itemFrame = Instance.new("Frame")
            itemFrame.Name = player.Name
            itemFrame.Size = UDim2.new(1, -6, 0, 24)
            itemFrame.BackgroundTransparency = 1
            itemFrame.ZIndex = 13
            itemFrame.Parent = PlayerListFrame

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(0.7, 0, 1, 0)
            nameLabel.Position = UDim2.new(0.03, 0, 0, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = player.DisplayName
            nameLabel.TextColor3 = Color3.fromRGB(220, 240, 255)
            nameLabel.Font = Enum.Font.SourceSans
            nameLabel.TextSize = 12
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.ZIndex = 14
            nameLabel.Parent = itemFrame

            local toggleBtn = Instance.new("TextButton")
            toggleBtn.Size = UDim2.new(0, 35, 0, 18)
            toggleBtn.Position = UDim2.new(0.75, 0, 0.5, -9)
            toggleBtn.Font = Enum.Font.SourceSansBold
            toggleBtn.TextSize = 10
            toggleBtn.ZIndex = 14
            toggleBtn.Parent = itemFrame

            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = toggleBtn

            local isSelected = SelectedPlayers[player.Name]
            if isSelected then
                toggleBtn.Text = "BẬT"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 216)
                toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                toggleBtn.Text = "TẮT"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                toggleBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
            end

            toggleBtn.MouseButton1Click:Connect(function()
                SelectedPlayers[player.Name] = not SelectedPlayers[player.Name]
                if SelectedPlayers[player.Name] then
                    toggleBtn.Text = "BẬT"
                    toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 216)
                    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    toggleBtn.Text = "TẮT"
                    toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                    toggleBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
                end
            end)
        end
    end
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 27)
end

