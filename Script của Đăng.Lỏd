local function CleanUpMapForFixLag(enable)
    if enable then
        task.spawn(function()
            local descendants = Workspace:GetDescendants()
            for i = 1, #descendants do
                local obj = descendants[i]
                if obj:IsA("BasePart") and not obj:IsA("MeshPart") then
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                end
                
                if i % 150 == 0 then
                    task.wait()
                end
            end
        end)
        
        if not fixLagConnection then
            fixLagConnection = RunService.RenderStepped:Connect(function()
                if LocalPlayer.Character then
                    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.CameraOffset = Vector3.new(0, 0, 0)
                    end
                end
            end)
        end
    else
        if fixLagConnection then
            fixLagConnection:Disconnect()
            fixLagConnection = nil
        end
    end
end

local function GetTargetPlayer()
    local closestTarget = nil
    local shortestScreenDistance = AimbotRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    local candidateModels = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and SelectedPlayers[player.Name] and player.Character then
            table.insert(candidateModels, player.Character)
        end
    end

    for _, model in ipairs(candidateModels) do
        local humanoid = model:FindFirstChildOfClass("Humanoid")

        if humanoid and humanoid.Health > 0 then
            local targetPart = model:FindFirstChild(AimbotTargetMode == "Đầu" and "Head" or "HumanoidRootPart")
            if targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if screenDist <= shortestScreenDistance then
                        shortestScreenDistance = screenDist
                        closestTarget = targetPart
                    end
                end
            end
        end
    end

    return closestTarget
end

RunService.RenderStepped:Connect(function(delta)
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Visible = AimbotEnabled

    if AimbotEnabled then
        local target = GetTargetPlayer()
        if target then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            local lerpFactor = math.clamp(delta * (AimbotSmoothness * 3), 0.01, 0.99)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, lerpFactor)
        end
    end
end)

