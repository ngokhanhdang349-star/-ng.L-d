        end)
        
        StatsLabel.Text = string.format("FPS: %d | Ping: %d ms", fps, ping)
    end
end)

local function AddClickEffect(button)
    local origSize = button.Size
    button.MouseButton1Down:Connect(function()
        button:TweenSize(UDim2.new(origSize.X.Scale * 0.9, origSize.X.Offset, origSize.Y.Scale * 0.9, origSize.Y.Offset), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.08, true)
    end)
    button.MouseButton1Up:Connect(function()
        button:TweenSize(origSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.08, true)
    end)
    button.MouseLeave:Connect(function()
        button:TweenSize(origSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.08, true)
    end)
end

